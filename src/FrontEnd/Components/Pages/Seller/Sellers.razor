@page "/sellers"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Enums
@using BillerContracts.Requests.Seller
@using BillerContracts.Responses.Seller
@using Microsoft.AspNetCore.Components.QuickGrid

@inject ISellerClient _sellerClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>Sellers</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Sellers</h1>
</div>

<div class="card">
    <div class="card-header">
        <b>Page size:</b>
        <select class="form-select" @bind="selectedPageSize" @bind:after="OnPageSizeChanged">
            <option value="@PageSize.p10">10</option>
            <option value="@PageSize.p25">25</option>
            <option value="@PageSize.p50">50</option>
        </select>
    </div>
    <div class="card-body">
        <QuickGrid TGridItem="SellerResponse" @ref="grid" ItemsProvider="LoadSellers" Pagination="pagination">
            <PropertyColumn Title="Name" Property="@(i => i.CompanyName)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Company number" Property="@(i => i.CompanyNumber)" Align="Align.Right" />
            <PropertyColumn Title="Email" Property="@(i => i.Email)" Align="Align.Right" />
            <PropertyColumn Title="Phone" Property="@(i => i.Phone)" Align="Align.Right" />
            <PropertyColumn Title="State" Property="@(i => i.State)" Align="Align.Right" />
            <PropertyColumn Title="City" Property="@(i => i.City)" Align="Align.Right" />
            <PropertyColumn Title="Street" Property="@(i => i.Street)" Align="Align.Right" />
            <PropertyColumn Title="Bank Name" Property="@(i => i.BankName)" Align="Align.Right" />
            <PropertyColumn Title="Bank number" Property="@(i => i.BankNumber)" Align="Align.Right" />
            <TemplateColumn Title="Action">
                <button @onclick="@(() => Edit(context))" class="btn btn-info">Edit</button>
                <button @onclick="@(() => Delete(context))" class="btn btn-danger">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="card-footer"><Paginator State="@pagination" /></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    PageSize selectedPageSize = PageSize.p10;
    PaginationState pagination = new() { ItemsPerPage = (int)PageSize.p10 };
    QuickGrid<SellerResponse> grid = default!;

    protected override async Task OnParametersSetAsync()
    {
        Page = Math.Max(1, Page);

        if (pagination.CurrentPageIndex != Page - 1)
            await pagination.SetCurrentPageIndexAsync(Page - 1);
    }

    async ValueTask<GridItemsProviderResult<SellerResponse>> LoadSellers(GridItemsProviderRequest<SellerResponse> request)
    {
        int page = (request.StartIndex / pagination.ItemsPerPage) + 1;

        if (page != Page)
            _navigationManager.NavigateTo(_navigationManager.GetUriWithQueryParameter("page", page), replace: true);

        SellerListResponse sellerList = await _sellerClient.Get(new SellerGetRequest()
        {
            PageSize = selectedPageSize,
            Page = page
        });

        return GridItemsProviderResult.From(sellerList.Sellers, sellerList.TotalCount);
    }

    async Task OnPageSizeChanged()
    {
        pagination.ItemsPerPage = (int)selectedPageSize;
        await pagination.SetCurrentPageIndexAsync(0);
    }

    void Edit(SellerResponse seller)
    {
        _navigationManager.NavigateTo($"/sellers/{seller.Id}", false);
    }

    async Task Delete(SellerResponse seller)
    {
        await _sellerClient.Delete(seller.Id);
        await grid.RefreshDataAsync();
    }
}
