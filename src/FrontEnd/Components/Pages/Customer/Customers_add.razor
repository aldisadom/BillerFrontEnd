@page "/customers/add"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Requests.Customer
@using BillerContracts.Requests.Series
@using BillerContracts.Responses.Series
@using BillerContracts.Responses

@inject NavigationManager _navigationManager
@inject ICustomerClient _customerClient
@inject ISeriesClient _seriesClient

@attribute [StreamRendering]

<PageTitle>Invoice address add</PageTitle>

<div style="display: flex; align-items: center;">
    <div style="margin-left: 20px;">
    <button @onclick="AddClick">Add</button>
    </div>      
</div>

<b>SellerId:</b>
<br />
<input type="text" @bind="customer.SellerId" @bind:after="LoadSeries" />
<br />
<b>Company name:</b>
<br />
<input type="text" @bind="customer.CompanyName" />
<br />
<b>Company number:</b>
<br />
<input type="text" @bind="customer.CompanyNumber" />
<br />
<b>Series:</b>
<br />
<select @bind="customer.SeriesId">
    @foreach (var series in seriesList)
    {
        <option value="@series.Id">@series.Name</option>
    }
</select>
<br />
<b>Email:</b>
<br />
<input type="text" @bind="customer.Email" />
<br />
<b>Phone:</b>
<br />
<input type="text" @bind="customer.Phone" />
<br />
<b>State:</b>
<br />
<input type="text" @bind="customer.State" />
<br />
<b>City:</b>
<br />
<input type="text" @bind="customer.City" />
<br />
<b>Street:</b>
<br />
<input type="text" @bind="customer.Street" />

@code {
    private CustomerAddRequest customer = new();
    private List<SeriesResponse> seriesList = [];

    [SupplyParameterFromQuery]
    private Guid? sellerId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (sellerId is not null)
        {
            customer.SellerId = sellerId.Value;
            await LoadSeries();
        }
    }

    private async Task LoadSeries()
    {
        seriesList = customer.SellerId == Guid.Empty
            ? []
            : (await _seriesClient.Get(new SeriesGetRequest { SellerId = customer.SellerId, PageSize = BillerContracts.Enums.PageSize.p50 })).Series;
        customer.SeriesId = seriesList.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task AddClick()
    {
        AddResponse response = await _customerClient.Add(customer);
        
        _navigationManager.NavigateTo($"/customers/{response.Id}", false);
    }
}
