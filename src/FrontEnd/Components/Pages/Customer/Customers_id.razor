@page "/customers/{IdString}"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Requests.Invoice
@using BillerContracts.Requests.Item
@using BillerContracts.Responses.Customer
@using BillerContracts.Responses.Invoice
@using BillerContracts.Responses.Item
@using Domain.Exceptions
@using FrontEnd.Capabilities
@using FrontEnd.Components.Pages.Invoice
@using Microsoft.AspNetCore.Components.QuickGrid

@inject NavigationManager _navigationManager
@inject ICustomerClient _customerClient
@inject IItemClient _itemClient
@inject IInvoiceClient _invoiceClient

@attribute [StreamRendering]

<PageTitle>Customer</PageTitle>
@if (customer == null)
{
    <h1>Customer</h1>
    <p><em>Loading...</em></p>
}
else
{
    <div style="display: flex; align-items: center;">
        <h1>@customer.CompanyName</h1>
        <div style="margin-left: 20px;">
            <button @onclick="EditClick">Edit</button>
        </div>
        <div style="margin-left: 20px;">
            <button @onclick="AddInvoiceClick">Add invoice</button>
        </div>
    </div>
    <b>Company name:</b>
    <br />
    @customer.CompanyName
    <br />
    <b>Company number:</b>
    <br />
    @customer.CompanyNumber
    <br />
    <b>Series:</b>
    <br />
    <a href="/series/update/@customer.SeriesId">@customer.SeriesName</a>
    <br />
    <b>Email:</b>
    <br />
    @customer.Email
    <br />
    <b>Phone:</b>
    <br />
    @customer.Phone
    <br />
    <b>State:</b>
    <br />
    @customer.State
    <br />
    <b>City:</b>
    <br />
    @customer.City
    <br />
    <b>Street:</b>
    <br />
    @customer.Street    
}
<br />
<div style="display: flex; align-items: center;">
    <h1>Invoice items:</h1>
    <div style="margin-left: 20px;">
        <button @onclick="AddItemClick">Add</button>
    </div>
</div>
@if (customer == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="card-header">
            <PageSizeSelect Paging="itemPaging" />
        </div>
        <div class="card-body">
            <QuickGrid TGridItem="ItemResponse" @ref="itemGrid" ItemsProvider="LoadItems" Pagination="itemPaging.Pagination">
                <PropertyColumn Title="Name" Property="@(i => i.Name)" Align="Align.Left" Class=" country-name" />
                <PropertyColumn Title="Price" Property="@(i => i.Price)" Align="Align.Right" />
                <PropertyColumn Title="Quantity" Property="@(i => i.Quantity)" Align="Align.Right" />
                <TemplateColumn Title="Action">
                    <button @onclick="@(() => EditItem(context))" class="btn btn-info">Edit</button>
                    <button @onclick="@(() => DeleteItem(context))" class="btn btn-danger">Delete</button>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="card-footer"><Paginator State="@itemPaging.Pagination" /></div>
    </div>
}
<br />
<div style="display: flex; align-items: center;">
    <h1>Invoices:</h1>
</div>
@if (customer == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="card-header">
            <PageSizeSelect Paging="invoicePaging" />
        </div>
        <div class="card-body">
            <QuickGrid TGridItem="InvoiceResponse" ItemsProvider="LoadInvoices" Pagination="invoicePaging.Pagination">
                <PropertyColumn Title="Series" Property="@(i => i.SeriesName)" Align="Align.Right" />
                <PropertyColumn Title="Invoice number" Property="@(i => i.InvoiceNumber)" Format="D6" Align="Align.Right" />
                <PropertyColumn Title="Date created" Property="@(p => p.CreatedDate)" Format="yyyy-MM-dd" />
                <PropertyColumn Title="Due date" Property="@(p => p.DueDate)" Format="yyyy-MM-dd" />
                <TemplateColumn Title="Status">
                    <InvoiceStatusLabel Status="@context.Status" />
                </TemplateColumn>
                <PropertyColumn Title="Total price" Property="@(i => i.TotalPrice)" Align="Align.Right" />
                <TemplateColumn Title="Action">
                    <button @onclick="@(() => OpenInvoice(context))" class="btn btn-info">Edit</button>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="card-footer"><Paginator State="@invoicePaging.Pagination" /></div>
    </div>
}

@code {
    [Parameter]
    public string IdString { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryItemPage { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? QueryItemPageSize { get; set; }

    [SupplyParameterFromQuery(Name = "invoicePage")]
    public int? QueryInvoicePage { get; set; }

    [SupplyParameterFromQuery(Name = "invoicePageSize")]
    public int? QueryInvoicePageSize { get; set; }

    private Guid customerId;
    private CustomerResponse? customer;

    private readonly GridPaging itemPaging = new();
    private readonly GridPaging invoicePaging = new("invoicePage", "invoicePageSize");
    private PagedGridsUrl url = default!;
    private QuickGrid<ItemResponse> itemGrid = default!;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(IdString) || !Guid.TryParse(IdString, out customerId))
        {
            throw new NotFoundException("Invalid id format");
        }

        url = new(_navigationManager, itemPaging, invoicePaging);
        customer = await _customerClient.Get(customerId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!url.UrlChanged())
            return;

        await itemPaging.Apply(QueryItemPage, QueryItemPageSize);
        await invoicePaging.Apply(QueryInvoicePage, QueryInvoicePageSize);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            url.Rendered();
    }

    private void EditClick()
    {
        _navigationManager.NavigateTo($"/customers/update/{IdString}", false);
    }

    private async Task DeleteClick()
    {
        await _customerClient.Delete(customerId);
        _navigationManager.NavigateTo("/customers", false);
    }

    async ValueTask<GridItemsProviderResult<ItemResponse>> LoadItems(GridItemsProviderRequest<ItemResponse> request)
    {
        url.Write();

        ItemListResponse itemList = await _itemClient.Get(new ItemGetRequest()
        {
            CustomerId = customerId,
            PageSize = itemPaging.PageSize,
            Page = itemPaging.Page
        });

        return GridItemsProviderResult.From(itemList.Items, itemList.TotalCount);
    }

    async ValueTask<GridItemsProviderResult<InvoiceResponse>> LoadInvoices(GridItemsProviderRequest<InvoiceResponse> request)
    {
        url.Write();

        InvoiceListResponse invoiceList = await _invoiceClient.Get(new InvoiceGetRequest()
        {
            CustomerId = customerId,
            PageSize = invoicePaging.PageSize,
            Page = invoicePaging.Page
        });

        return GridItemsProviderResult.From(invoiceList.Invoices, invoiceList.TotalCount);
    }

    void OpenInvoice(InvoiceResponse invoice)
    {
        _navigationManager.NavigateTo($"/invoices/{invoice.Id}", false);
    }

    void EditItem(ItemResponse item)
    {
        _navigationManager.NavigateTo($"/items/{item.Id}", false);
    }

    async Task DeleteItem(ItemResponse item)
    {
        await _itemClient.Delete(item.Id);
        await itemGrid.RefreshDataAsync();
    }

    private void AddItemClick()
    {
        _navigationManager.NavigateTo($"/items/add?customerId={customerId}", false);
    }

    private void AddInvoiceClick()
    {
        _navigationManager.NavigateTo($"/invoices/add?customerId={customerId}", false);
    }
}
