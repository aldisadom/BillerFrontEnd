@page "/customers"
@using BillerContracts.Requests.Customer
@using BillerContracts.Responses.Customer
@using BillerContracts.Clients.Interfaces
@using FrontEnd.Capabilities
@using Microsoft.AspNetCore.Components.QuickGrid

@inject ICustomerClient _customerClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>Invoice addresses</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Customers</h1>
</div>

<div class="card">
    <div class="card-header">
        <PageSizeSelect Paging="paging" />
    </div>
    <div class="card-body">
        <QuickGrid TGridItem="CustomerResponse" @ref="grid" ItemsProvider="LoadCustomers" Pagination="paging.Pagination">
            <PropertyColumn Title="Name" Property="@(i => i.CompanyName)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Company number" Property="@(i => i.CompanyNumber)" Align="Align.Right" />
            <PropertyColumn Title="Series" Property="@(i => i.SeriesName)" Align="Align.Right" />
            <PropertyColumn Title="Email" Property="@(i => i.Email)" Align="Align.Right" />
            <PropertyColumn Title="Phone" Property="@(i => i.Phone)" Align="Align.Right" />
            <PropertyColumn Title="State" Property="@(i => i.State)" Align="Align.Right" />
            <PropertyColumn Title="City" Property="@(i => i.City)" Align="Align.Right" />
            <PropertyColumn Title="Street" Property="@(i => i.Street)" Align="Align.Right" />
            <PropertyColumn Title="Seller id" Property="@(i => i.SellerId)" Align="Align.Left" />
            <TemplateColumn Title="Action">
                <button @onclick="@(() => Edit(context))" class="btn btn-info">Edit</button>
                <button @onclick="@(() => Delete(context))" class="btn btn-danger">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="card-footer"><Paginator State="@paging.Pagination" /></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? QueryPageSize { get; set; }

    readonly GridPaging paging = new();
    PagedGridsUrl url = default!;
    QuickGrid<CustomerResponse> grid = default!;

    protected override void OnInitialized()
    {
        url = new(_navigationManager, paging);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (url.UrlChanged())
            await paging.Apply(QueryPage, QueryPageSize);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            url.Rendered();
    }

    async ValueTask<GridItemsProviderResult<CustomerResponse>> LoadCustomers(GridItemsProviderRequest<CustomerResponse> request)
    {
        url.Write();

        CustomerListResponse customerList = await _customerClient.Get(new CustomerGetRequest()
        {
            PageSize = paging.PageSize,
            Page = paging.Page
        });

        return GridItemsProviderResult.From(customerList.Customers, customerList.TotalCount);
    }

    void Edit(CustomerResponse customer)
    {
        _navigationManager.NavigateTo($"/customers/{customer.Id}", false);
    }

    async Task Delete(CustomerResponse customer)
    {
        await _customerClient.Delete(customer.Id);
        await grid.RefreshDataAsync();
    }
}
