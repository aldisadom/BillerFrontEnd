@page "/users"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Requests.User
@using BillerContracts.Responses.User
@using FrontEnd.Capabilities
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IUserClient _userClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>Users</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Users</h1>
    <div style="margin-left: 20px;">
        <button @onclick="AddClick">Add</button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <PageSizeSelect Paging="paging" />
    </div>
    <div class="card-body">
        <QuickGrid TGridItem="UserResponse" @ref="grid" ItemsProvider="LoadUsers" Pagination="paging.Pagination">
            <PropertyColumn Title="Email" Property="@(i => i.Email)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Name" Property="@(i => i.Name)" Align="Align.Right" />
            <PropertyColumn Title="Last name" Property="@(i => i.LastName)" Align="Align.Right" />
            <TemplateColumn Title="Action">
                <button @onclick="@(() => Edit(context))" class="btn btn-info">Edit</button>
                <button @onclick="@(() => Delete(context))" class="btn btn-danger">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="card-footer"><Paginator State="@paging.Pagination" /></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? QueryPageSize { get; set; }

    readonly GridPaging paging = new();
    PagedGridsUrl url = default!;
    QuickGrid<UserResponse> grid = default!;

    protected override void OnInitialized()
    {
        url = new(_navigationManager, paging);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (url.UrlChanged())
            await paging.Apply(QueryPage, QueryPageSize);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            url.Rendered();
    }

    async ValueTask<GridItemsProviderResult<UserResponse>> LoadUsers(GridItemsProviderRequest<UserResponse> request)
    {
        url.Write();

        UserListResponse userList = await _userClient.Get(new UserGetRequest()
        {
            PageSize = paging.PageSize,
            Page = paging.Page
        });

        return GridItemsProviderResult.From(userList.Users, userList.TotalCount);
    }

    void Edit(UserResponse user)
    {
        _navigationManager.NavigateTo($"/users/{user.Id}", false);
    }

    async Task Delete(UserResponse user)
    {
        await _userClient.Delete(user.Id);
        await grid.RefreshDataAsync();
    }

    private void AddClick()
    {
        _navigationManager.NavigateTo($"/users/add", false);
    }
}
