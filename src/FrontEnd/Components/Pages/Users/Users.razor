@page "/users"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Enums
@using BillerContracts.Requests.User
@using BillerContracts.Responses.User
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IUserClient _userClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>Users</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Users</h1>
    <div style="margin-left: 20px;">
        <button @onclick="AddClick">Add</button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <b>Page size:</b>
        <select class="form-select" @bind="selectedPageSize" @bind:after="OnPageSizeChanged">
            <option value="@PageSize.p10">10</option>
            <option value="@PageSize.p25">25</option>
            <option value="@PageSize.p50">50</option>
        </select>
    </div>
    <div class="card-body">
        <QuickGrid TGridItem="UserResponse" @ref="grid" ItemsProvider="LoadUsers" Pagination="pagination">
            <PropertyColumn Title="Email" Property="@(i => i.Email)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Name" Property="@(i => i.Name)" Align="Align.Right" />
            <PropertyColumn Title="Last name" Property="@(i => i.LastName)" Align="Align.Right" />
            <TemplateColumn Title="Action">
                <button @onclick="@(() => Edit(context))" class="btn btn-info">Edit</button>
                <button @onclick="@(() => Delete(context))" class="btn btn-danger">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="card-footer"><Paginator State="@pagination" /></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    PageSize selectedPageSize = PageSize.p10;
    PaginationState pagination = new() { ItemsPerPage = (int)PageSize.p10 };
    QuickGrid<UserResponse> grid = default!;

    protected override async Task OnParametersSetAsync()
    {
        Page = Math.Max(1, Page);

        if (pagination.CurrentPageIndex != Page - 1)
            await pagination.SetCurrentPageIndexAsync(Page - 1);
    }

    async ValueTask<GridItemsProviderResult<UserResponse>> LoadUsers(GridItemsProviderRequest<UserResponse> request)
    {
        int page = (request.StartIndex / pagination.ItemsPerPage) + 1;

        if (page != Page)
            _navigationManager.NavigateTo(_navigationManager.GetUriWithQueryParameter("page", page), replace: true);

        UserListResponse userList = await _userClient.Get(new UserGetRequest()
        {
            PageSize = selectedPageSize,
            Page = page
        });

        return GridItemsProviderResult.From(userList.Users, userList.TotalCount);
    }

    async Task OnPageSizeChanged()
    {
        pagination.ItemsPerPage = (int)selectedPageSize;
        await pagination.SetCurrentPageIndexAsync(0);
    }

    void Edit(UserResponse user)
    {
        _navigationManager.NavigateTo($"/users/{user.Id}", false);
    }

    async Task Delete(UserResponse user)
    {
        await _userClient.Delete(user.Id);
        await grid.RefreshDataAsync();
    }

    private void AddClick()
    {
        _navigationManager.NavigateTo($"/users/add", false);
    }
}
