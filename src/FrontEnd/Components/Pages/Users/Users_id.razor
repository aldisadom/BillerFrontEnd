@page "/users/{IdString}"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Enums
@using BillerContracts.Requests.Seller
@using BillerContracts.Requests.User
@using BillerContracts.Responses.Customer
@using BillerContracts.Responses.Seller
@using BillerContracts.Responses.User
@using Domain.Exceptions
@using Microsoft.AspNetCore.Components.QuickGrid

@inject ISellerClient _sellerClient
@inject IUserClient _userClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>User</PageTitle>
@if (user == null)
{
    <h1>User</h1>
    <p><em>Loading...</em></p>
}
else
{
    <div style="display: flex; align-items: center;">
        <h1>@user!.Name</h1>        
        <div style="margin-left: 20px;">
            <button @onclick="EditClick">Edit</button>
        </div>
        <div style="margin-left: 20px;">
            <button @onclick="AddInvoiceClick">Add invoice</button>
        </div>
    </div>
    <b>Email:</b>
    <br />
    @user.Email
    <br />
    <b>Name:</b>
    <br />
    @user.Name
    <br />        
    <b>LastName:</b>
    <br />
    @user.LastName    
}
<br />
<div style="display: flex; align-items: center;">
    <h1>Sellers:</h1>
    <div style="margin-left: 20px;">
        <button @onclick="AddSellerClick">Add</button>
    </div>
</div>
@if (user == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card">
        <div class="card-header">
            <b>Page size:</b>
            <select class="form-select" @bind="selectedPageSize" @bind:after="OnPageSizeChanged">
                <option value="@PageSize.p10">10</option>
                <option value="@PageSize.p25">25</option>
                <option value="@PageSize.p50">50</option>
            </select>
        </div>
        <div class="card-body">
            <QuickGrid TGridItem="SellerResponse" @ref="grid" ItemsProvider="LoadSellers" Pagination="pagination">
                <PropertyColumn Title="Name" Property="@(i => i.CompanyName)" Align="Align.Left" Class=" country-name" />
                <PropertyColumn Title="Company number" Property="@(i => i.CompanyNumber)" Align="Align.Right" />
                <PropertyColumn Title="Email" Property="@(i => i.Email)" Align="Align.Right" />
                <PropertyColumn Title="Phone" Property="@(i => i.Phone)" Align="Align.Right" />
                <PropertyColumn Title="State" Property="@(i => i.State)" Align="Align.Right" />
                <PropertyColumn Title="City" Property="@(i => i.City)" Align="Align.Right" />
                <PropertyColumn Title="Street" Property="@(i => i.Street)" Align="Align.Right" />
                <TemplateColumn Title="Action">
                    <button @onclick="@(() => EditSeller(context))" class="btn btn-info">Edit</button>
                    <button @onclick="@(() => DeleteSeller(context))" class="btn btn-danger">Delete</button>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="card-footer"><Paginator State="@pagination" /></div>
    </div>    
}

@code {
    [Parameter]
    public string IdString { get; set; } = string.Empty;

    private Guid userId;
    private UserResponse? user;

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    private PageSize selectedPageSize = PageSize.p10;
    private PaginationState pagination = new() { ItemsPerPage = (int)PageSize.p10 };
    private QuickGrid<SellerResponse> grid = default!;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(IdString) || !Guid.TryParse(IdString, out userId))
        {
            throw new NotFoundException("Invalid id format");
        }

        user = await _userClient.Get(userId);
    }

    protected override async Task OnParametersSetAsync()
    {
        Page = Math.Max(1, Page);

        if (pagination.CurrentPageIndex != Page - 1)
            await pagination.SetCurrentPageIndexAsync(Page - 1);
    }

    private void EditClick()
    {
        _navigationManager.NavigateTo($"/users/update/{IdString}", false);
    }    

    private async Task DeleteClick()
    {
        await _userClient.Delete(userId);
        _navigationManager.NavigateTo("/users", false);
    }

    async ValueTask<GridItemsProviderResult<SellerResponse>> LoadSellers(GridItemsProviderRequest<SellerResponse> request)
    {
        int page = (request.StartIndex / pagination.ItemsPerPage) + 1;

        if (page != Page)
            _navigationManager.NavigateTo(_navigationManager.GetUriWithQueryParameter("page", page), replace: true);

        SellerListResponse sellerList = await _sellerClient.Get(new SellerGetRequest()
        {
            UserId = userId,
            PageSize = selectedPageSize,
            Page = page
        });

        return GridItemsProviderResult.From(sellerList.Sellers, sellerList.TotalCount);
    }

    async Task OnPageSizeChanged()
    {
        pagination.ItemsPerPage = (int)selectedPageSize;
        await pagination.SetCurrentPageIndexAsync(0);
    }

    void EditSeller(SellerResponse item)
    {
        _navigationManager.NavigateTo($"/items/{item.Id}", false);
    }

    async Task DeleteSeller(SellerResponse item)
    {
        await _sellerClient.Delete(item.Id);
        await grid.RefreshDataAsync();
    }

    private void AddSellerClick()
    {
        _navigationManager.NavigateTo($"/sellers/add?userId={userId}", false);
    }

    private void AddInvoiceClick()
    {
        _navigationManager.NavigateTo($"/invoices/add?userId={userId}", false);
    }
}
