@page "/invoices"
@using BillerContracts.Requests.Invoice
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Responses.Invoice
@using FrontEnd.Capabilities
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IInvoiceClient _invoiceClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>Invoices</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Invoices</h1>
</div>

<div class="card">
    <div class="card-header">
        <PageSizeSelect Paging="paging" />
    </div>
    <div class="card-body">
        <QuickGrid TGridItem="InvoiceResponse" @ref="grid" ItemsProvider="LoadInvoices" Pagination="paging.Pagination">
            <PropertyColumn Title="Seller" Property="@(i => i.SellerName)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Customer" Property="@(i => i.CustomerName)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Series" Property="@(i => i.SeriesName)" Align="Align.Right" />
            <PropertyColumn Title="Invoice number" Property="@(i => i.InvoiceNumber)" Format="D6" Align="Align.Right" />
            <PropertyColumn Title="Date created" Property="@(p => p.CreatedDate)" Format="yyyy-MM-dd" />
            <PropertyColumn Title="Due date" Property="@(p => p.DueDate)" Format="yyyy-MM-dd" />
            <TemplateColumn Title="Status">
                <InvoiceStatusLabel Status="@context.Status" />
            </TemplateColumn>
            <PropertyColumn Title="Total price" Property="@(i => i.TotalPrice)" Align="Align.Right" />
            <TemplateColumn Title="Action">
                <button @onclick="@(() => Edit(context))" class="btn btn-info">Edit</button>
                <button @onclick="@(() => Delete(context))" class="btn btn-danger">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="card-footer"><Paginator State="@paging.Pagination" /></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? QueryPageSize { get; set; }

    readonly GridPaging paging = new();
    PagedGridsUrl url = default!;
    QuickGrid<InvoiceResponse> grid = default!;

    protected override void OnInitialized()
    {
        url = new(_navigationManager, paging);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (url.UrlChanged())
            await paging.Apply(QueryPage, QueryPageSize);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            url.Rendered();
    }

    async ValueTask<GridItemsProviderResult<InvoiceResponse>> LoadInvoices(GridItemsProviderRequest<InvoiceResponse> request)
    {
        url.Write();

        InvoiceListResponse invoiceList = await _invoiceClient.Get(new InvoiceGetRequest()
        {
            PageSize = paging.PageSize,
            Page = paging.Page
        });

        return GridItemsProviderResult.From(invoiceList.Invoices, invoiceList.TotalCount);
    }

    void Edit(InvoiceResponse invoice)
    {
        _navigationManager.NavigateTo($"/invoices/{invoice.Id}", false);
    }

    async Task Delete(InvoiceResponse invoice)
    {
        await _invoiceClient.Delete(invoice.Id);
        await grid.RefreshDataAsync();
    }
}
