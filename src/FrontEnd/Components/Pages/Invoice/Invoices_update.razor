@page "/invoices/update/{IdString}"
@using BillerContracts.Requests.Invoice
@using BillerContracts.Responses.Invoice
@using BillerContracts.Responses.Item
@using BillerContracts.Clients.Interfaces
@using Domain.Exceptions
@using Domain.Models
@using FrontEnd.Capabilities
@using FrontEnd.MappingProfiles

@inject NavigationManager _navigationManager
@inject IInvoiceClient _invoiceClient
@inject IItemClient _itemClient

@attribute [StreamRendering]

<PageTitle>Invoice</PageTitle>

@if (invoiceUpdate == null)
{
    <h1>Invoice</h1>
    <p><em>Loading...</em></p>
}
else
{
    <div style="display: flex; align-items: center;">
        <h1>Invoice</h1>
        <div style="margin-left: 20px;">
            <button @onclick="UpdateClick">Update</button>
        </div>
        <div style="margin-left: 20px;">
            <button @onclick="DeleteClick">Delete</button>
        </div>
    </div>    
    <b>Invoice:</b>
    <br />
    @invoice?.SeriesName @invoice?.InvoiceNumber.ToString("D6")
    <br />
    <b>Date created:</b>
    <br />
    <input type="date" @bind="invoiceUpdate.CreatedDate" />
    <br />
    <b>Due date:</b>
    <br />
    <input type="date" @bind="invoiceUpdate.DueDate" />
    <br />
    <b>Comments:</b>
    <br />
    <input type="text" @bind="invoiceUpdate.Comments" />
    <br />
    <b>Seller name:</b>
    <br />
    @invoice?.SellerName
    <br />
    <b>Customer name:</b>
    <br />
    @invoice?.CustomerName
    <br />
    <b>Items:</b>
    @if (invoiceUpdate.Items.Any(IsOutdated))
    {
        <button style="margin-left: 20px;" @onclick="RefreshAllClick">Refresh all</button>
    }
    <br />
    <table class="table">
        <thead>
            <tr>
                <td style="width:30%">Items</td>
                <td style="width:20%">Version</td>
                <td style="width:29%">Comment</td>
                <td style="width:7%">Quantity</td>
                <td style="width:7%">Unit price</td>
                <td style="width:7%">Total price</td>
            </tr>
        </thead>
        <tbody>
            @for (int z = 0; z < itemFilters.Count; z++)
            {
                int index = z;
                <tr>
                    <td>
                        <select class="form-select" @bind="@itemFilters[index].SelectedId">
                            @foreach (var filter in itemFilters[index].SelectionList)
                            {
                                <option value=@filter.Key>@filter.Value</option>
                            }
                        </select>
                        @if (itemFilters[index].Changed())
                        {
                            ItemChange(index);
                        }
                    </td>
                    @if (itemFilters[index].IsValid())
                    {
                        InvoiceItemRequest line = invoiceUpdate.Items[index];
                        decimal unitPrice = LinePrice(line);
                        <td>
                            @if (versionsByItem.TryGetValue(line.Id, out List<ItemVersionResponse>? versions))
                            {
                                <select class="form-select" @bind="invoiceUpdate.Items[index].Version">
                                    @if (line.Version is null)
                                    {
                                        <option value="">@AppFilterHelper.InvalidName</option>
                                    }
                                    @foreach (var version in versions)
                                    {
                                        <option value="@version.Version">v@(version.Version) @version.Name @version.Price</option>
                                    }
                                </select>
                                @if (IsOutdated(line))
                                {
                                    <button @onclick="() => RefreshClick(index)">Refresh</button>
                                }
                            }
                            else if (line.Version is not null)
                            {
                                @($"v{line.Version}")
                            }
                        </td>
                        <td>
                            <input type="text" @bind="invoiceUpdate.Items[index].Comments" />
                        </td>
                        <td>
                            <input type="decimal" @bind="invoiceUpdate.Items[index].Quantity" />
                        </td>
                        <td>
                            @unitPrice
                        </td>
                        <td>
                            @(unitPrice * line.Quantity)
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <b>Total:</b>
    <br />
    decimal totalPrice = invoiceUpdate.Items.Sum(line => LinePrice(line) * line.Quantity);
    <b>@totalPrice</b>
    <br /> 
}

@code {
    [Parameter]
    public string IdString { get; set; } = string.Empty;

    private Guid invoiceId;

    private InvoiceResponse? invoice;
    private InvoiceUpdateRequest? invoiceUpdate;

    private List<ItemResponse>? itemsList;
    private Dictionary<Guid, List<ItemVersionResponse>> versionsByItem = new();
    private Dictionary<(Guid Id, int? Version), InvoiceItemResponse> deletedItemLines = new();

    private List<AppFilter> itemFilters { get; set; } = new();
    private List<(Guid Id, int? Version)?> originalLines = new();

    private int? CurrentVersion(Guid itemId)
    {
        return itemsList?.Find(i => i.Id == itemId)?.Version;
    }

    private bool IsOutdated(InvoiceItemRequest line)
    {
        int? current = CurrentVersion(line.Id);
        return current is not null && (line.Version is null || line.Version < current);
    }

    private decimal LinePrice(InvoiceItemRequest line)
    {
        if (versionsByItem.TryGetValue(line.Id, out List<ItemVersionResponse>? versions))
        {
            ItemVersionResponse? version = versions.Find(v => v.Version == line.Version);
            if (version is not null)
                return version.Price;
        }

        return deletedItemLines.TryGetValue((line.Id, line.Version), out InvoiceItemResponse? stored) ? stored.Price : 0;
    }

    private void RefreshClick(int index)
    {
        if (invoiceUpdate is null || index >= invoiceUpdate.Items.Count)
            return;

        InvoiceItemRequest line = invoiceUpdate.Items[index];
        if (IsOutdated(line))
            line.Version = CurrentVersion(line.Id);
    }

    private void RefreshAllClick()
    {
        if (invoiceUpdate is null)
            return;

        foreach (InvoiceItemRequest line in invoiceUpdate.Items.Where(IsOutdated))
            line.Version = CurrentVersion(line.Id);
    }

    public void ItemChange(int index)
    {        
        bool add = itemFilters[index].WasUnselected();
        Guid selectedId = itemFilters[index].SelectedId;

        itemFilters[index].UpdateSelected();

        if (!itemFilters[index].IsValid())
        {
            if (index == itemFilters.Count - 1)
                return;

            itemFilters.RemoveAt(index);
            invoiceUpdate!.Items.RemoveAt(index);
            originalLines.RemoveAt(index);
            return;
        }

        if (add)
            invoiceUpdate!.Items.Add(new InvoiceItemRequest());

        invoiceUpdate!.Items[index].Id = selectedId;
        invoiceUpdate!.Items[index].Version = originalLines[index] is { } original && original.Id == selectedId
            ? original.Version
            : CurrentVersion(selectedId);

        if (add)
        {
            originalLines.Add(null);
            itemFilters.Add(new AppFilter());
            foreach (var item in itemsList!)
                itemFilters[itemFilters.Count - 1].SelectionList.Add(item.Id, item.Name);
        }            
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(IdString) || !Guid.TryParse(IdString, out invoiceId))
        {
            throw new NotFoundException("Invalid id format");
        }

        invoice = await _invoiceClient.Get(invoiceId);
        invoiceUpdate = invoice.ToUpdateRequest();

        await GetItems(invoiceUpdate.CustomerId);

        ItemVersionListResponse[] versionLists = await Task.WhenAll(itemsList!.Select(item => _itemClient.GetVersions(item.Id)));
        foreach (ItemVersionListResponse versionList in versionLists)
            versionsByItem[versionList.ItemId] = versionList.Versions;

        foreach (InvoiceItemResponse line in invoice.Items ?? [])
            if (!versionsByItem.ContainsKey(line.Id))
                deletedItemLines[(line.Id, line.Version)] = line;

        originalLines = invoiceUpdate.Items.Select(line => ((Guid Id, int? Version)?)(line.Id, line.Version)).ToList();
        originalLines.Add(null);

        itemFilters = new List<AppFilter>();
        for (int i = 0; i < invoiceUpdate.Items.Count + 1; i++)
        {
            itemFilters.Add(new AppFilter());
            foreach (var item in itemsList!)
                itemFilters[i].SelectionList.Add(item.Id, item.Name);
        }

        for (int i = 0; i < invoiceUpdate.Items.Count; i++)
        {
            Guid itemId = invoiceUpdate.Items[i].Id;
            if (deletedItemLines.TryGetValue((itemId, invoiceUpdate.Items[i].Version), out InvoiceItemResponse? stored))
                itemFilters[i].SelectionList.TryAdd(itemId, stored.Name);

            itemFilters[i].UpdateSelected(itemId);
        }
    }

    private async Task GetItems(Guid customerId)
    {
        itemsList = await _itemClient.GetAllForCustomer(customerId);
    }

    private async Task UpdateClick()
    {        
        await _invoiceClient.Update(invoiceUpdate!);

        _navigationManager.NavigateTo($"/invoices/{invoiceId}", false);
    }

    private async Task DeleteClick()
    {
        await _invoiceClient.Delete(invoiceId);
        _navigationManager.NavigateTo("/invoices", false);
    }
}
