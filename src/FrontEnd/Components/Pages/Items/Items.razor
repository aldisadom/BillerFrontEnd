@page "/items"
@using BillerContracts.Clients.Interfaces
@using BillerContracts.Requests.Item
@using BillerContracts.Responses.Item
@using FrontEnd.Capabilities
@using Microsoft.AspNetCore.Components.QuickGrid

@inject IItemClient _itemClient
@inject NavigationManager _navigationManager

@attribute [StreamRendering]

<PageTitle>Items</PageTitle>
<div style="display: flex; align-items: center;">
    <h1>Items</h1>
</div>

<div class="card">
    <div class="card-header">
        <PageSizeSelect Paging="paging" />
    </div>
    <div class="card-body">
        <QuickGrid TGridItem="ItemResponse" @ref="grid" ItemsProvider="LoadItems" Pagination="paging.Pagination">
            <PropertyColumn Title="Name" Property="@(i => i.Name)" Align="Align.Left" Class=" country-name" />
            <PropertyColumn Title="Price" Property="@(i => i.Price)" Align="Align.Right" />
            <PropertyColumn Title="Quantity" Property="@(i => i.Quantity)" Align="Align.Right" />
            <TemplateColumn Title="Action">
                <button @onclick="@(() => Edit(context))" class="btn btn-info">Edit</button>
                <button @onclick="@(() => Delete(context))" class="btn btn-danger">Delete</button>
            </TemplateColumn>
        </QuickGrid>
    </div>
    <div class="card-footer"><Paginator State="@paging.Pagination" /></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? QueryPageSize { get; set; }

    readonly GridPaging paging = new();
    PagedGridsUrl url = default!;
    QuickGrid<ItemResponse> grid = default!;

    protected override void OnInitialized()
    {
        url = new(_navigationManager, paging);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (url.UrlChanged())
            await paging.Apply(QueryPage, QueryPageSize);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            url.Rendered();
    }

    async ValueTask<GridItemsProviderResult<ItemResponse>> LoadItems(GridItemsProviderRequest<ItemResponse> request)
    {
        url.Write();

        ItemListResponse itemList = await _itemClient.Get(new ItemGetRequest()
        {
            PageSize = paging.PageSize,
            Page = paging.Page
        });

        return GridItemsProviderResult.From(itemList.Items, itemList.TotalCount);
    }

    void Edit(ItemResponse item)
    {
        _navigationManager.NavigateTo($"/items/{item.Id}", false);
    }

    async Task Delete(ItemResponse item)
    {
        await _itemClient.Delete(item.Id);
        await grid.RefreshDataAsync();
    }
}

