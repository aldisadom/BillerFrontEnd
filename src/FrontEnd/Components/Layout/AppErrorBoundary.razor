@using FrontEnd.Capabilities
@inherits ErrorBoundary
@implements IDisposable

@inject NavigationManager _navigationManager
@inject IJSRuntime _jsRuntime
@inject ILogger<AppErrorBoundary> _logger

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="alert alert-danger" role="alert">
        <p>@ErrorMessages.For(CurrentException)</p>
        <button class="btn btn-primary" @onclick="Recover">Try again</button>
        <button class="btn btn-secondary" @onclick="BackClick">Back</button>
    </div>
}

@code {
    private IDisposable? _locationChangingRegistration;

    protected override void OnAfterRender(bool firstRender)
    {
        // Only possible once interactive: prerendering has no navigation to hook into
        if (firstRender)
            _locationChangingRegistration = _navigationManager.RegisterLocationChangingHandler(OnLocationChanging);
    }

    protected override Task OnErrorAsync(Exception exception)
    {
        _logger.LogError(exception, "Unhandled error on {Uri}", _navigationManager.Uri);
        return Task.CompletedTask;
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        // Clear the old page's error before the new page renders, so an error the new page throws stays
        await InvokeAsync(Recover);
    }

    private async Task BackClick()
    {
        await _jsRuntime.InvokeVoidAsync("history.back");
    }

    public void Dispose()
    {
        _locationChangingRegistration?.Dispose();
    }
}
