{
  "DetailedErrors": true,
  "ClientsOptions": {
    "UserUrl": "http://127.0.0.1:8090/users",
    "CustomerUrl": "http://127.0.0.1:8090/customers",
    "SellerUrl": "http://127.0.0.1:8090/sellers",
    "ItemUrl": "http://127.0.0.1:8090/items",
    "InvoiceUrl": "http://127.0.0.1:8090/invoices",
    "SeriesUrl": "http://127.0.0.1:8090/series"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
